{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsm.storage.io/v1alpha3/execution-profile.schema.json",
  "title": "LHPS ExecutionProfile (hsm.storage.io/v1alpha3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "hsm.storage.io/v1alpha3" },
    "kind": { "const": "ExecutionProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "minLength": 1, "maxLength": 253 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "retry", "workerLease", "circuitBreaker"],
      "properties": {
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global"],
          "properties": {
            "global": { "type": "integer", "minimum": 1 },
            "perOST": { "type": "integer", "minimum": 1 }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoff", "initialDelay", "maxDelay", "retryableErrors"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "backoff": { "enum": ["fixed", "exponential"] },
            "initialDelay": { "$ref": "#/$defs/duration" },
            "maxDelay": { "$ref": "#/$defs/duration" },
            "retryableErrors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["transient_io", "backend_busy", "backend_unavailable", "backend_timeout", "unknown_submission"] }
            }
          }
        },
        "workerLease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ttl", "renewEvery", "onLeaseLost"],
          "properties": {
            "ttl": { "$ref": "#/$defs/duration" },
            "renewEvery": { "$ref": "#/$defs/duration" },
            "onLeaseLost": { "const": "stop_and_reconcile" }
          }
        },
        "circuitBreaker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scopes"],
          "properties": {
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["domain", "errorClasses", "evaluation", "conditions", "onOpen", "resetMode"],
                "properties": {
                  "domain": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["key"],
                    "properties": { "key": { "enum": ["policy", "filesystem", "archive_id", "archive_backend_endpoint"] } }
                  },
                  "errorClasses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["transient_io", "backend_busy", "backend_unavailable", "backend_timeout", "unknown_submission"] }
                  },
                  "evaluation": { "const": "any" },
                  "conditions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "threshold"],
                      "properties": {
                        "type": { "enum": ["consecutive_failures", "failure_count", "failure_rate"] },
                        "threshold": { "type": "number", "minimum": 0 },
                        "minSamples": { "type": "integer", "minimum": 1 },
                        "window": { "$ref": "#/$defs/duration" }
                      }
                    }
                  },
                  "onOpen": { "const": "suspend_submissions" },
                  "resetMode": { "enum": ["manual", "manual_or_probe"] }
                }
              }
            }
          }
        },
        "admissionWindow": { "$ref": "#/$defs/admissionWindow" }
      }
    }
  },
  "$defs": {
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$" },
    "admissionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "weekly": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "start", "end"],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
              },
              "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            }
          }
        }
      }
    }
  }
}
