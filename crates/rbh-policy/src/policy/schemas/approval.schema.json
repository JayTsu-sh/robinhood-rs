{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsm.storage.io/v1alpha3/approval.schema.json",
  "title": "LHPS ApprovalPolicy (hsm.storage.io/v1alpha3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "hsm.storage.io/v1alpha3" },
    "kind": { "const": "ApprovalPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "minLength": 1, "maxLength": 253 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDecision"],
      "properties": {
        "defaultDecision": { "enum": ["allow", "deny"] },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "effects": {
                "type": "array",
                "items": { "enum": ["notify", "read_only_io", "metadata_mutation", "data_copy", "data_release", "destructive", "external_effect"] }
              },
              "actions": { "type": "array", "items": { "type": "string" } },
              "mode": { "enum": ["not_required", "required", "deny"] },
              "minApprovers": { "type": "integer", "minimum": 1 },
              "approverRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "separationOfDuties": { "type": "boolean" },
              "ttl": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h|d)$" },
              "binding": { "const": "plan_digest" },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "filesystems": { "type": "array", "items": { "type": "string" } } }
              }
            }
          }
        },
        "floorDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minApprovers", "approverRoles"],
          "properties": {
            "minApprovers": { "type": "integer", "minimum": 1 },
            "approverRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
