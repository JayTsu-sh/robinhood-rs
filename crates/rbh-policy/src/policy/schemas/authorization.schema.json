{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsm.storage.io/v1alpha3/authorization.schema.json",
  "title": "LHPS AuthorizationPolicy (hsm.storage.io/v1alpha3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "hsm.storage.io/v1alpha3" },
    "kind": { "const": "AuthorizationPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "minLength": 1, "maxLength": 253 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDecision", "statements"],
      "properties": {
        "defaultDecision": { "enum": ["allow", "deny"] },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "decision", "subjects", "actions", "scope"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["allow", "deny"] },
              "subjects": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "serviceAccounts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              },
              "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "filesystems": { "type": "array", "items": { "type": "string" } },
                  "objectTypes": {
                    "type": "array",
                    "items": { "enum": ["file", "directory", "archive_copy_tombstone"] }
                  },
                  "namespacePrefixes": { "type": "array", "items": { "type": "string" } },
                  "ostNames": { "type": "array", "items": { "type": "string" } },
                  "archiveIds": { "type": "array", "items": { "type": "integer" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
