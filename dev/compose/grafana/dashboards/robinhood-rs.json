{
  "title": "robinhood-rs",
  "uid": "robinhood-rs",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "tags": ["robinhood", "lustre"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "mdt",
        "label": "MDT",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(rbh_changelog_events_total, source)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Catalog entries",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rbh_catalog_entries", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Changelog events / sec (per MDT, per type)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (source, event_type) (rate(rbh_changelog_events_total{source=~\"$mdt\"}[1m]))",
          "legendFormat": "{{source}} {{event_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
