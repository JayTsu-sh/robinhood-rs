# Publish console operations. Use the daemon's loopback listener for the full API.
map "$request_method:$uri" $rbh_console_api_allowed {
    default 0;
    ~^(GET|HEAD):/api/(health|filesystems|policies|runs|action-contracts|selectors|execution-profiles|authorization-policies|approval-policies|system-safety-policies)(/|$) 1;
    ~^POST:/api/filesystems/(management(/[^/]+)?|refresh)$ 1;
    ~^POST:/api/policies(/preview|/[0-9]+/(preview|run))?$ 1;
    ~^POST:/api/runs/[0-9]+/control$ 1;
    ~^(PUT|PATCH):/api/policies/[0-9]+$ 1;
}

map $http_origin $rbh_console_origin {
    "" "$scheme://$http_host";
    default $http_origin;
}

server {
    listen ${RBH_CONSOLE_HTTP_LISTEN} default_server;
    return 421;
}

server {
    listen ${RBH_CONSOLE_HTTP_LISTEN};
    server_name ${RBH_CONSOLE_HTTP_HOST};
    allow ${RBH_CONSOLE_TRUSTED_CIDR};
    deny all;
    absolute_redirect off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;

    location = / { return 302 /console/; }
    location = /console { return 302 /console/; }

    location /console/ {
        limit_except GET { deny all; }
        proxy_pass http://unix:/run/rbh-gateway/daemon.sock:;
    }

    location /api/ {
        if ($rbh_console_origin != "$scheme://$http_host") { return 403; }
        if ($rbh_console_api_allowed = 0) { return 405; }
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${RBH_CONSOLE_GATEWAY_TOKEN}";
        proxy_pass http://unix:/run/rbh-gateway/daemon.sock:/api/;
    }

    location / { return 404; }
}
